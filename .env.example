# Copy to .env and source from the repository root; never commit credentials.
SIGNET_ISSUER=https://signet.wu-boy.com
MCP_RESOURCE=http://localhost:8000/mcp
LISTEN_ADDR=127.0.0.1:8000
READ_SCOPE=notes:read
WRITE_SCOPE=notes:write
# Public client, pre-registered by instructor (no client secret).
OAUTH_CLIENT_ID=replace-with-instructor-provided-public-client-id
# Lab 05 only: separate per-team confidential client, NOT the public OAuth client.
INTROSPECTION_CLIENT_ID=
INTROSPECTION_CLIENT_SECRET=
# Lab 06 only: generate with scripts/configure_gateway.py; don't share this value.
GATEWAY_SHARED_SECRET=
